# ==== App ====
APP_NAME=NGO LMS
ENVIRONMENT=development
DEBUG=true

# ==== Database ====
# Production (Render Postgres): paste the "Internal Database URL" Render gives you.
# IMPORTANT: if Render gives you a URL starting with "postgres://", change it to
# "postgresql://" (SQLAlchemy 2.x requires the postgresql:// prefix).
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Local dev alternative (SQLite file, zero setup):
# DATABASE_URL=sqlite:///./ngo_lms.db

# ==== JWT ====
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== CORS ====
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ==== Storage ====
# local | cloudinary | s3 (only "local" is implemented for now)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200

# ==== Head Admin seed (created automatically on first run) ====
HEAD_ADMIN_EMAIL=admin@ngolms.org
HEAD_ADMIN_PASSWORD=ChangeMe123!
HEAD_ADMIN_NAME=Head Admin
